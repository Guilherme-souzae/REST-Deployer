pipeline {
    agent any

    triggers {
        githubPush()
    }

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        EC2_HOST = '34.203.35.196'
    }

    stages {
        stage('Setup Python') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/python -m pip install --upgrade pip
                    .venv/bin/python -m pip install -r python/requirements.txt
                    .venv/bin/python -m pip install pytest
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    .venv/bin/python -m pytest \
                        python/tests.py \
                        --junitxml=pytest-report.xml
                '''
            }
            post {
                always {
                    junit(
                        testResults: 'pytest-report.xml',
                        allowEmptyResults: false
                    )
                }
            }
        }

        stage('Deploy AWS') {
            steps {
                sshagent(credentials: ['ec2-deploy-key']) {
                    sh '''
                        set -eu

                        ssh \
                          -o StrictHostKeyChecking=accept-new \
                          ec2-user@${EC2_HOST} 'bash -se' <<'REMOTE'
set -eu

REPO=/home/ec2-user/REST-Deployer

if [ -d "$REPO/.git" ]; then
    cd "$REPO"
    git fetch origin main
    git reset --hard origin/main
else
    git clone \
        https://github.com/Guilherme-souzae/REST-Deployer.git \
        "$REPO"
    cd "$REPO"
fi

sudo docker build \
    -t rest-deployer-api ./python

sudo docker rm -f rest-deployer-api || true

sudo docker run -d \
    --name rest-deployer-api \
    --restart unless-stopped \
    -p 5000:5000 \
    rest-deployer-api

sudo docker ps --filter name=rest-deployer-api
REMOTE
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Testes passaram e o deploy foi executado!'
        }
        failure {
            echo 'Falha no pipeline. Verifique os testes e os logs.'
        }
        always {
            echo 'Pipeline finalizado.'
        }
    }
}