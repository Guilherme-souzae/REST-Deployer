pipeline {
    agent any

    triggers {
        githubPush()
    }

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        EC2_HOST = credentials('hostip')
    }

    stages {
        stage('Setup Python') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/python -m pip install --upgrade pip
                    .venv/bin/python -m pip install -r python/requirements.txt
                    .venv/bin/python -m pip install pytest
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    .venv/bin/python -m pytest \
                        python/tests.py \
                        --junitxml=pytest-report.xml
                '''
            }
            post {
                always {
                    junit(
                        testResults: 'pytest-report.xml',
                        allowEmptyResults: false
                    )
                }
            }
        }

        stage('Deploy AWS') {
            steps {
                sshagent(credentials: ['hyperuser']) {
                    sh '''
                        set -eu

                        ssh \
                          -o StrictHostKeyChecking=accept-new \
                          ubuntu@${EC2_HOST} 'bash -se' <<'REMOTE'
                        set -eu

                        REPO=/home/ubuntu/REST-Deployer

                        if [ -d "$REPO/.git" ]; then
                            cd "$REPO"
                            git fetch origin main
                            git reset --hard origin/main
                        else
                            git clone \
                                https://github.com/Guilherme-souzae/REST-Deployer.git \
                                "$REPO"
                            cd "$REPO"
                        fi

                        sudo docker build \
                            -t rest-deployer-api ./python

                        sudo docker rm -f rest-deployer-api || true

                        sudo docker run -d \
                            --name rest-deployer-api \
                            --restart unless-stopped \
                            -p 5000:5000 \
                            rest-deployer-api

                        sudo docker ps --filter name=rest-deployer-api
                        REMOTE
                    '''
                }
            }
        }

        stage('Wait') {
            steps {
                sleep time: 20, unit: 'SECONDS'
            }
        }

        stage('Newman runtime tests') {
            steps {
                withCredentials([string(credentialsId: 'deploy-host-ip', variable: 'DEPLOY_HOST')]) {
                    sh '''
                        mkdir -p newman-reports
                        docker run --rm \
                          -v "$WORKSPACE/postman:/etc/newman/collections:ro" \
                          -v "$WORKSPACE/newman-reports:/etc/newman/reports" \
                          postman/newman:alpine run /etc/newman/collections/api.postman_collection.json \
                          --env-var baseUrl=http://$DEPLOY_HOST:5000 \
                          --reporters cli,junit \
                          --reporter-junit-export /etc/newman/reports/newman.xml
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Testes passaram e o deploy foi executado!'
        }
        failure {
            echo 'Falha no pipeline. Verifique os testes e os logs.'
        }
        always {
            echo 'Pipeline finalizado.'
        }
    }
}
