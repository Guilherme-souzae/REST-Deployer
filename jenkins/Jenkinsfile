
pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Setup python') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/python -m pip install --upgrade pip
                    .venv/bin/python -m pip install -r python/requirements.txt
                '''
            }
        }

        stage('Unit tests') {
            steps {
                sh '''
                    .venv/bin/python -m pytest python/tests.py --junitxml=pytest-report.xml
                '''
            }

            post {
                always {
                    junit testResults: 'pytest-report.xml',
                          allowEmptyResults: false
                }
            }
        }
    }

    post {
        success {
            echo 'Todos os testes unitários passaram!'
        }

        failure {
            echo 'Falha no pipeline. Verifique os testes e os logs.'
        }

        always {
            echo 'Pipeline finalizado.'
        }
    }
}
